# Base URL of the ffmpeg transcode proxy used for AC3 MKV playback.
# Leave empty to play MKV URLs directly (audio may be silent in Chrome on AC3 content).
# Local dev: http://localhost:8787
# Production: https://streamforest-transcode.fly.dev
VITE_TRANSCODE_PROXY_URL=

# TMDB (themoviedb.org) — metadata enrichment.
# Get keys at https://www.themoviedb.org/settings/api
VITE_TMDB_BEARER=
VITE_TMDB_API_KEY=

# Shared secret for reading the device diagnostics log (`npm run logs`).
# Must match CLIENT_LOG_TOKEN on the transcode server. Unset on the server means
# reads are refused outright — the log carries device fingerprints and viewing
# activity, so it must never be readable without one.
CLIENT_LOG_TOKEN=

# Where `npm run logs` reads from. VITE_TRANSCODE_PROXY_URL points at localhost
# during development, but the devices whose logs matter talk to the tunnel.
CLIENT_LOG_BASE=
